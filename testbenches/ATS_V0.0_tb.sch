C {devices/code.sym} -2440 -1370 0 0 {name=TT_MODELS
only_toplevel=true
format="tcleval( @value )"
value="
** opencircuitdesign pdks install
.lib $::SKYWATER_MODELS/sky130.lib.spice tt

"
spice_ignore=false}
C {devices/simulator_commands_shown.sym} -3010 -1370 0 0 {name=COMMANDS1
simulator=ngspice
only_toplevel=false 
value="
.option savecurrents
.temp 27

* Case #1 -> 100 Hz
Vin vin 0 SIN(0 0.5 100 0 0)
*Vreset vreset 0 PULSE(1.8 0 0 1u 1u 900u 1000u)

* Case #2 -> 10 Hz
*Vin vin 0 SIN(-0.5 1.8 10 0 0)
*Vreset vreset 0 PULSE(1.8 0 0 100u 100u 9m 10m)

* Case #3 -> 1 Hz
*Vin vin 0 SIN(0 1.8 1 0 0)
*Vreset vreset 0 PULSE(1.8 0 0 1m 1m 90m 100m)

.control
save all
op

* Case #1 -> Run 40 ms
*tran 1u 0.04

* Case #2 -> Run 400 ms
*tran 100u 0.4

* Case #3 -> Run 4 s
*tran 1m 4

plot vin vout

write ATS_V0.0.raw

.endc
"}
C {launcher.sym} -1510 -1380 0 0 {name=h5
