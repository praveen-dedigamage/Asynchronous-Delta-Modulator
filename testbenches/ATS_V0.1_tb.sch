C {devices/simulator_commands_shown.sym} -3030 -1410 0 0 {name=COMMANDS1
simulator=ngspice
only_toplevel=false
spice_ignore=false
value="
.option savecurrents
.temp 27

* Case #1 -> 100 Hz
Vin vin 0 SIN(0 0.8 100 0 0)
*Vin1 n2 n1 SIN(0 0.8 150 0 0)
*Vin2 n3 n1 SIN(0 0.9 250 0 0)
*Vin4 vin n3 SIN(0 0.6 200 0 0)
*Vreset vreset 0 PULSE(1.8 0 0 1u 1u 900u 1000u)

* Case #2 -> 10 Hz
*Vin vin 0 SIN(-0.5 1.8 10 0 0)
*Vreset vreset 0 PULSE(1.8 0 0 100u 100u 9m 10m)

* Case #3 -> 1 Hz
*Vin vin 0 SIN(0 1.8 1 0 0)
*Vin vin 0 PULSE(0 0.8 0 100m 1 1 2)
*Vreset vreset 0 PULSE(1.8 0 0 1m 1m 90m 100m)

.control
save all
*op

* Case #1 -> Run 40 ms
tran 1u 0.04

* Case #2 -> Run 400 ms
*tran 100u 0.4

* Case #3 -> Run 4 s
*tran 1m 10

plot vin vdiff vsf

write ATS_V0.1.raw

.endc
"}
